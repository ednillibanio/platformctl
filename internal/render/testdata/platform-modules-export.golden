# Generated by platformctl export. Evaluate it with eval or source; never store it.
__platformctl_export() {
  local __platformctl_s1 __platformctl_s2 __platformctl_s3
  __platformctl_s1="$(cat -- "$HOME"/'.config/assembleiarr/lab/credentials/platform-modules/PM_BUILD_PASSWORD')" || { printf '%s\n' 'platformctl export: cannot read secret file ~/.config/assembleiarr/lab/credentials/platform-modules/PM_BUILD_PASSWORD for PM_BUILD_PASSWORD' >&2; return 1; }
  if [ -z "${GITHUB_TOKEN:-}" ]; then printf '%s\n' 'platformctl export: environment variable GITHUB_TOKEN is not set (for PM_GITHUB_TOKEN)' >&2; return 1; fi
  __platformctl_s2="$GITHUB_TOKEN"
  __platformctl_s3="$(cat -- "$HOME"/'.config/assembleiarr/lab/credentials/platform-modules/PM_VSPHERE_PASSWORD')" || { printf '%s\n' 'platformctl export: cannot read secret file ~/.config/assembleiarr/lab/credentials/platform-modules/PM_VSPHERE_PASSWORD for PM_VSPHERE_PASSWORD' >&2; return 1; }
  export PM_ANSIBLE_KEY='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleOnlyNotARealKey000000000000000 platform-modules-lab'
  export PM_ANSIBLE_PRIVATE_KEY_FILE='/home/vagrant/.config/assembleiarr/lab/credentials/platform-modules/id_ed25519'
  export PM_BUILD_PASSWORD="$__platformctl_s1"
  export PM_BUILD_USERNAME='vagrant'
  export PM_COMMON_DATA_SOURCE='http'
  export PM_COMMON_HTTP_PORT_MAX='8099'
  export PM_COMMON_HTTP_PORT_MIN='8000'
  export PM_COMMON_REMOVE_CDROM='true'
  export PM_COMMON_TEMPLATE_CONVERSION='false'
  export PM_COMMON_VM_VERSION='19'
  export PM_GITHUB_TOKEN="$__platformctl_s2"
  export PM_GIT_USER_EMAIL='operator@example.invalid'
  export PM_GIT_USER_NAME='Platform Operator'
  export PM_PACKER_ENABLE_LOG='false'
  export PM_VSPHERE_DATASTORE='DATASTORE_01'
  export PM_VSPHERE_ENDPOINT='esxi01.lab.example.internal'
  export PM_VSPHERE_FOLDER=''
  export PM_VSPHERE_HOST='esxi01.lab.example.internal'
  export PM_VSPHERE_INSECURE_CONNECTION='true'
  export PM_VSPHERE_NETWORK='VM Network'
  export PM_VSPHERE_PASSWORD="$__platformctl_s3"
  export PM_VSPHERE_RESOURCE_POOL=''
  export PM_VSPHERE_SET_HOST_FOR_DATASTORE_UPLOADS='false'
  export PM_VSPHERE_USERNAME='root'
}
if __platformctl_export; then unset -f __platformctl_export; else unset -f __platformctl_export; false; fi
